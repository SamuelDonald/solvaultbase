# Copy to .env.local and adjust as needed. None of these are secret — they're
# all shown to users in the app anyway (receiving wallet, fees, network).

# devnet | testnet | mainnet-beta  (defaults to devnet — safe, no real funds)
VITE_SOLBASE_NETWORK=devnet

# Defaults to the public cluster RPC for whichever network you set above.
# Swap in a dedicated RPC provider (Helius, QuickNode, Triton, etc.) before
# going to mainnet — the public endpoint is heavily rate-limited.
# VITE_SOLBASE_RPC_URL=https://your-rpc-provider.example.com

VITE_SOLBASE_RECEIVING_WALLET=DXVdPZ4SKvtbX7DxRgCB7n9Wh9Te1LrJqfnsSwMs8J9W
VITE_SOLBASE_LAUNCH_FEE=1
VITE_SOLBASE_NETWORK_FEE=0.05
